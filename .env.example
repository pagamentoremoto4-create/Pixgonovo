PIXGO_API_KEY=sua_chave_pixgo
ADMIN_NUMBER=5575999999999
ADMIN_NUMBERS=5575999999999,5575888888888
ADMIN_TELEGRAM_ID=123456789
TELEGRAM_BOT_TOKEN=seu_token_telegram
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASS=sua_senha
BASE_URL=https://seuapp.onrender.com

DATA_DIR=/data
DB_PATH=/data/database.db
ESIM_DIR=/data/esim
BACKUP_DIR=/data/backups
SUPORTE_TELEGRAM=alinesantos3360

# WhatsApp direto por QR Code
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=baileys
WHATSAPP_SESSION_DIR=/data/whatsapp-session
WHATSAPP_LOG_LEVEL=silent

# IA somente no WhatsApp (Google Gemini)

# IA especialista CentralUnlocker
# Informações extras opcionais, em uma única linha. Exemplo: Horário de atendimento: 08h às 18h. Prazo médio: consulte suporte.

# Formas de pagamento
PIXGO_API_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
# E-mail técnico enviado ao Mercado Pago no cadastro do pagador
MERCADO_PAGO_PAYER_EMAIL=cliente@centralunlocker.com.br
# URL pública do Render, necessária para o webhook
BASE_URL=https://seu-app.onrender.com

# OpenAI - IA somente no WhatsApp
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=300
IA_ENABLED=false

# WhatsApp com 3 sessões independentes
# A sessão principal continua sendo o Bot de Serviços.
WHATSAPP_SUPPORT_ENABLED=true
WHATSAPP_ADS_ENABLED=true
WHATSAPP_SUPPORT_SESSION_DIR=/data/whatsapp-support-session
WHATSAPP_ADS_SESSION_DIR=/data/whatsapp-ads-session
# Número do Bot de Serviços no formato DDI+DDD+número, sem + ou espaços
WHATSAPP_BOT_SERVICOS=55XXXXXXXXXXX
# IA do suporte: true/false (também pode ser alterada pelo painel)
IA_SUPPORT_ENABLED=true

# VTEST-SHARED-ESIM: chave privada usada pelo bot Telegramesim.
# Use exatamente a mesma chave nos dois serviços.
